---
import { getCollection } from "astro:content";
import LocaleRedirect from "../../../components/LocaleRedirect.astro";

export async function getStaticPaths() {
  const docs = (await getCollection("platform-conformance")).filter((doc) => doc.id.startsWith("desktop/"));
  const slugs = new Set(docs.map((doc) => doc.id.split("/")[2]));
  return [...slugs].map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
---
<LocaleRedirect path={ `legals/desktop/${ slug }/` } />
