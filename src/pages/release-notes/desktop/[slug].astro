---
import { getCollection } from "astro:content";
import LocaleRedirect from "../../../components/LocaleRedirect.astro";

export async function getStaticPaths() {
  const notes = await getCollection("desktop-release-notes");
  const slugs = new Set(notes.map((note) => note.id.slice(note.id.indexOf("/") + 1)));
  return [...slugs].map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
---
<LocaleRedirect path={ `release-notes/desktop/${ slug }/` } />
