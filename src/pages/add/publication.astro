---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import PageHeader from "../../components/sections/PageHeader.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { t } from "../../i18n/utils.js";
import { addPublicationScheme } from "../../links.js";

const lang = "en";
---

<Layout title={ t(lang, "badge.landing.publication.title") + " — " + t(lang, "site.title") }>
  <PageHeader
    title={ t(lang, "badge.landing.publication.title") }
    body={ t(lang, "badge.landing.publication.subtitle") }
  />

  <section class="add-landing-section">
    <div class="container">
      <div class="add-landing-actions">
        <a id="open-btn" href="#" class="btn action-button-accent">
          { t(lang, "badge.landing.publication.open") }
        </a>
        <a href={ getRelativeLocaleUrl(lang, "download") } class="btn action-button">
          { t(lang, "badge.landing.publication.download") }
        </a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<script define:vars={{ addPublicationScheme }}>
  const params = new URLSearchParams(window.location.search);
  const title = params.get("title");

  if (title) {
    const titleEl = document.querySelector(".page-header h1");
    if (titleEl) titleEl.textContent = title;
  }

  const openBtn = document.getElementById("open-btn");
  if (openBtn) {
    openBtn.setAttribute("href", `${ addPublicationScheme }${ window.location.search }`);
  }
</script>
