---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { locales } from "../../../../i18n/locales.js";

export async function getStaticPaths() {
  const docs = (await getCollection("platform-conformance")).filter((doc) => doc.id.startsWith("desktop/"));
  const slugs = new Set(docs.map((doc) => doc.id.split("/")[2]));
  return locales.flatMap((lang) =>
    [...slugs].map((slug) => ({
      params: { lang, slug },
    }))
  );
}

const lang = Astro.currentLocale ?? "en";
const { slug } = Astro.params;
return Astro.redirect(getRelativeLocaleUrl(lang, `legals/desktop/${ slug }`));
---
