---
import { getCollection, render } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../../../layouts/Layout.astro";
import Footer from "../../../components/Footer.astro";
import { locales } from "../../../i18n/locales.js";
import { t, formatDate, interpolate, localizeCollection, getPlatforms } from "../../../i18n/utils.js";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.currentLocale ?? "en";
const legalsPages = await getCollection("legals-pages");
const legalsDoc = localizeCollection(legalsPages, lang).find(({ slug }) => slug === "legals")?.note;

if (!legalsDoc) {
  throw new Error("Missing legal page content at src/content/legals/en/legals.md");
}

const { Content } = await render(legalsDoc);

const allPlatformDocs = await getCollection("platform-conformance");
const platforms = getPlatforms(allPlatformDocs);

const sortDocsByDateAndTitle = (a: { note: (typeof allPlatformDocs)[number] }, b: { note: (typeof allPlatformDocs)[number] }) => {
  const aDate = a.note.data.date ?? "";
  const bDate = b.note.data.date ?? "";

  if (aDate && bDate) {
    return bDate.localeCompare(aDate);
  }

  if (aDate || bDate) {
    return bDate ? 1 : -1;
  }

  return a.note.data.title.localeCompare(b.note.data.title);
};
---

<Layout title={ legalsDoc.data.title }>
  <article class="platform-doc container">
    <h1>{ legalsDoc.data.title }</h1>
    { legalsDoc.data.date && (
      <time datetime={ legalsDoc.data.date }>{ formatDate(lang, legalsDoc.data.date) }</time>
    ) }
    <Content />

    { platforms.map((platform) => {
      const docs = localizeCollection(allPlatformDocs, lang, platform).sort(sortDocsByDateAndTitle);
      const platformName = t(lang, `platform.names.${ platform }`) as string;
      const title = interpolate(t(lang, "legals.platformTitle") as string, { platform: platformName });

      return (
        <Fragment>
          <h2>{ title }</h2>
          <ul class="legals-platform-list">
            { docs.map(({ slug, note }) => (
              <li>
                <a href={ getRelativeLocaleUrl(lang, `legals/${ platform }/${ slug }`) }>
                  { note.data.title }
                </a>
                { note.data.date && (
                  <time datetime={ note.data.date }>{ formatDate(lang, note.data.date) }</time>
                ) }
              </li>
            )) }
          </ul>
        </Fragment>
      );
    }) }
  </article>
  <Footer slot="footer" />
</Layout>
