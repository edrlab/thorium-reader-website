---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import PageHeader from "../../components/sections/PageHeader.astro";
import { t } from "../../i18n/utils.js";
import { locales } from "../../i18n/locales.js";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.currentLocale;

const generators = [
  {
    path: "badge/catalog/",
    title: t(lang, "badge.index.catalog.title"),
    subtitle: t(lang, "badge.index.catalog.subtitle"),
  },
  {
    path: "badge/publication/",
    title: t(lang, "badge.index.publication.title"),
    subtitle: t(lang, "badge.index.publication.subtitle"),
  },
];
---

<Layout title={ t(lang, "badge.index.title") + " — " + t(lang, "site.title") }>
  <PageHeader title={ t(lang, "badge.index.title") } />

  <section class="badge-hub-section">
    <div class="container">
      <ul class="badge-hub-list">
        { generators.map(({ path, title, subtitle }) => (
          <li class="badge-hub-item">
            <a href={ getRelativeLocaleUrl(lang, path) } class="badge-hub-link">{ title }</a>
            <p class="badge-hub-item-subtitle">{ subtitle }</p>
          </li>
        )) }
      </ul>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>
