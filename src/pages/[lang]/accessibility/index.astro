---
import { getEntry, render } from "astro:content";
import Layout from "../../../layouts/Layout.astro";
import Footer from "../../../components/Footer.astro";
import { locales } from "../../../i18n/locales.js";
import { formatDate } from "../../../i18n/utils.js";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.currentLocale ?? "en";
const accessibilityDoc = await getEntry("legals-pages", "accessibility");

if (!accessibilityDoc) {
  throw new Error("Missing accessibility content at src/content/legals/accessibility.md");
}

const { Content } = await render(accessibilityDoc);
---

<Layout title={ accessibilityDoc.data.title }>
  <section class="conformance-index container">
    <h1>{ accessibilityDoc.data.title }</h1>
    {accessibilityDoc.data.date && (
      <time datetime={ accessibilityDoc.data.date }>{ formatDate(lang, accessibilityDoc.data.date) }</time>
    )}
    <Content />
  </section>
  <Footer slot="footer" />
</Layout>
