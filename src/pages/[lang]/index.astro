---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/sections/HeroSection.astro";
import FeatureSection from "../../components/sections/FeatureSection.astro";
import BookWalkerDecoration from "../../components/decorations/BookWalkerDecoration.astro";
import TippedBoxDecoration from "../../components/decorations/TippedBoxDecoration.astro";
import CTASection from "../../components/sections/CTASection.astro";
import FAQ from "../../components/sections/FAQ.astro";
import Footer from "../../components/Footer.astro";
import DownloadButton from "../../components/buttons/DownloadButton.astro";
import DiscordButton from "../../components/buttons/DiscordButton.astro";
import { t, getImage } from "../../i18n/utils.js";
import { locales } from "../../i18n/locales.js";
import { discordHref } from "../../config.js";
import rawCtaWaveBottom from "../../assets/shapes/thorium-shape-3-wave-bottom.svg?raw";
export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.currentLocale;
---

<Layout>
  <Image
    slot="hero-decoration"
    class="hero-illustration"
    src={ getImage(lang, "thorium-illustration-01.webp")}
    alt=""
  />

  <Hero
    title={ t(lang, "home.hero.title") }
    body={ t(lang, "home.hero.subtitle") }
    image={{ src: getImage(lang, "thorium-reader-mobile-option.webp"), alt: t(lang, "home.alts.thorium-reader-mobile-option") }}
    clipImage
  >
    <div slot="actions" class="hero-actions">
      <DownloadButton icon href={`${ import.meta.env.BASE_URL }${ lang }/download`} />
      <DiscordButton href={ discordHref } />
    </div>
  </Hero>

  <div class="mobile-hero-illustration" aria-hidden="true">
    <Image src={ getImage(lang, "thorium-illustration-01.webp") } alt="" />
  </div>

  <FeatureSection
    title={ t(lang, "home.features.customize.title") }
    body={ t(lang, "home.features.customize.body") }
  >
    <DownloadButton slot="actions" variant="accent" href={`${ import.meta.env.BASE_URL }${ lang }/download`} label={ t(lang, "button.downloadApp") } />
    <figure>
      <Image src={ getImage(lang, "thorium-reader-screens.webp") } alt={ t(lang, "home.alts.thorium-reader-screens") } />
    </figure>
  </FeatureSection>

  <FeatureSection
    title={ t(lang, "home.features.library.title") }
    body={ t(lang, "home.features.library.body") }
    reverse
  >
    <DownloadButton slot="actions" variant="accent" href={`${ import.meta.env.BASE_URL }${ lang }/download`} label={ t(lang, "button.downloadApp") } />
    <figure role="none">
      <Image src={ getImage(lang, "thorium-desktop.webp") } alt={ t(lang, "home.alts.thorium-desktop") } />
    </figure>
    <BookWalkerDecoration slot="decoration" lang={ lang } />
  </FeatureSection>

  <CTASection
    title={ t(lang, "home.cta.section.title") }
    body={ t(lang, "home.cta.section.subtitle") }
  >
    <TippedBoxDecoration slot="border-top" lang={ lang } />
    <DownloadButton slot="actions" icon href={`${ import.meta.env.BASE_URL }${ lang }/download`} label={ t(lang, "button.downloadApp") } />
    <Image slot="media" src={ getImage(lang, "thorium-reader-desktop-mobile.webp") } alt={ t(lang, "home.alts.thorium-reader-desktop-mobile") } />
    <div slot="border-bottom" class="cta-wave cta-wave-bottom" aria-hidden="true">
      <Fragment set:html={ rawCtaWaveBottom } />
    </div>
  </CTASection>

  <FAQ
    title={ t(lang, "home.faq.title") }
    items={ t(lang, "home.faq.items", { returnObjects: true }) as { question: string; answer: string; items?: string[] }[] }
  />

  <Footer image={{ src: getImage(lang, "thorium-illustration-04.webp"), alt: t(lang, "home.alts.thorium-illustration-04") }} clip />
</Layout>
