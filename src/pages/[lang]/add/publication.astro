---
import Layout from "../../../layouts/Layout.astro";
import Footer from "../../../components/Footer.astro";
import DownloadContent from "../../../components/shared-content/DownloadContent.astro";
import ThoriumBadge from "../../../components/badge/ThoriumBadge.astro";
import ClientData from "../../../components/ClientData.astro";
import { t, splitLinks, type LinkSlot } from "../../../i18n/utils.js";
import { locales } from "../../../i18n/locales.js";
import { addPublicationScheme } from "../../../links.js";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.currentLocale ?? "en";
const publicationTitleFallback = t(lang, "add.publication.fallbackName");
const badgeAlt = t(lang, "badge.shared.alt");

const introBody = t(lang, "add.publication.body", { returnObjects: true }) as string[];
const retryLinkSlots: Record<string, LinkSlot & { id: string }> = {
  thisLink: { href: "#", text: t(lang, "add.publication.thisLink"), id: "retry-link" },
};
---

<Layout title={ t(lang, "add.publication.title") + " — " + t(lang, "site.title") }>
  <div class="page-intro">
    <h1>{ t(lang, "add.publication.title") }</h1>
    { introBody.map(paragraph => (
      <p>{ splitLinks(paragraph, retryLinkSlots).map(seg => typeof seg === "string" ? seg : <a href={ seg.href } id={ seg.id }>{ seg.text }</a>) }</p>
    )) }
  </div>

  <section class="add-landing-section">
    <div class="container">
      <div class="add-landing-actions">
        <ThoriumBadge
          id="open-btn"
          line1={ t(lang, "badge.shared.buttonLine1") }
          line2={ t(lang, "badge.shared.buttonLine2") }
          title={ t(lang, "badge.shared.button") }
        />
      </div>
    </div>
  </section>

  <DownloadContent lang={ lang } />

  <ClientData
    id="add-publication-data"
    data={{
      "data-scheme": addPublicationScheme,
      "data-publication-title-fallback": publicationTitleFallback,
      "data-badge-alt": badgeAlt,
    }}
  />

  <Footer slot="footer" />
</Layout>

<script>
  import { interpolate } from "../../../i18n/utils.js";

  const dataEl = document.getElementById("add-publication-data") as HTMLElement;
  const addPublicationScheme = dataEl.dataset.scheme!;
  const publicationTitleFallback = dataEl.dataset.publicationTitleFallback!;
  const badgeAlt = dataEl.dataset.badgeAlt!;

  const params = new URLSearchParams(window.location.search);
  const title = params.get("title");

  const subtitleEl = document.querySelector(".page-intro p");
  if (subtitleEl) {
    subtitleEl.textContent = interpolate(subtitleEl.textContent, { publicationTitle: title || publicationTitleFallback });
  }

  const retryHref = `${ addPublicationScheme }${ window.location.search }`;

  const openBtn = document.getElementById("open-btn");
  if (openBtn) openBtn.setAttribute("href", retryHref);

  const retryLink = document.getElementById("retry-link");
  if (retryLink) retryLink.setAttribute("href", retryHref);

  if (title) {
    const badgeSvg = openBtn?.querySelector("svg");
    if (badgeSvg) {
      const badgeTitle = interpolate(badgeAlt, { name: title });
      badgeSvg.setAttribute("aria-label", badgeTitle);
      const titleEl = badgeSvg.querySelector("title");
      if (titleEl) titleEl.textContent = badgeTitle;
    }
  }
</script>
