---
import Layout from "../../../layouts/Layout.astro";
import Footer from "../../../components/Footer.astro";
import PageHeader from "../../../components/sections/PageHeader.astro";
import DownloadContent from "../../../components/shared-content/DownloadContent.astro";
import ThoriumBadge from "../../../components/badge/ThoriumBadge.astro";
import { t } from "../../../i18n/utils.js";
import { locales } from "../../../i18n/locales.js";
import { addCatalogScheme } from "../../../links.js";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.currentLocale;
---

<Layout title={ t(lang, "badge.landing.catalog.title") + " — " + t(lang, "site.title") }>
  <PageHeader
    title={ t(lang, "badge.landing.catalog.title") }
    body={ t(lang, "badge.landing.catalog.subtitle") }
  />

  <section class="add-landing-section">
    <div class="container">
      <div class="add-landing-actions">
        <ThoriumBadge
          id="open-btn"
          line1={ t(lang, "badge.shared.buttonLine1") }
          line2={ t(lang, "badge.shared.buttonLine2") }
          title={ t(lang, "badge.shared.button") }
        />
      </div>
    </div>
  </section>

  <DownloadContent lang={ lang } />

  <Footer slot="footer" />
</Layout>

<script define:vars={{ addCatalogScheme }}>
  const params = new URLSearchParams(window.location.search);
  const title = params.get("title");

  if (title) {
    const titleEl = document.querySelector(".page-header h1");
    if (titleEl) titleEl.textContent = title;
  }

  const openBtn = document.getElementById("open-btn");
  if (openBtn) {
    openBtn.setAttribute("href", `${ addCatalogScheme }${ window.location.search }`);
  }
</script>
