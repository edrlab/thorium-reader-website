---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import { locales } from "../../../../i18n/locales.js";
import { localizeCollection } from "../../../../i18n/utils.js";

export async function getStaticPaths() {
  const notes = await getCollection("desktop-release-notes");
  return locales.map((lang) => {
    const latest = localizeCollection(notes, lang).sort((a, b) => b.note.data.date.localeCompare(a.note.data.date))[0];
    return {
      params: { lang },
      props: { latestSlug: latest.slug },
    };
  });
}

const lang = Astro.currentLocale ?? "en";
const { latestSlug } = Astro.props;

return Astro.redirect(getRelativeLocaleUrl(lang, `release-notes/desktop/${ latestSlug }`));
---
