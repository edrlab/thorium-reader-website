---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../../../layouts/Layout.astro";
import Footer from "../../../components/Footer.astro";
import { locales } from "../../../i18n/locales.js";
import { t, formatDate } from "../../../i18n/utils.js";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.currentLocale ?? "en";

const desktopNotes = await getCollection("desktop-release-notes");
const sortedDesktop = desktopNotes.sort((a, b) => b.data.date.localeCompare(a.data.date));

const platforms = [
  {
    label: t(lang, "release-notes.platforms.desktop"),
    indexPath: "release-notes/desktop/",
    notes: sortedDesktop.slice(0, 5).map((n) => ({ id: n.id, version: n.data.version, date: n.data.date, path: `release-notes/desktop/${ n.id }` })),
  },
];
---

<Layout title={ t(lang, "release-notes.title") } noBlob={ true }>
  <section class="release-notes-hub container">
    <h1>{ t(lang, "release-notes.title") }</h1>
    { platforms.map(({ label, indexPath, notes }) => (
      <div class="release-notes-hub-platform">
        <h2>{ label }</h2>
        <ul>
          { notes.map(({ version, date, path }) => (
            <li>
              <a href={ getRelativeLocaleUrl(lang, path) }>v{ version }</a>
              <time datetime={ date }>{ formatDate(lang, date) }</time>
            </li>
          )) }
        </ul>
        <a class="release-notes-hub-see-all" href={ getRelativeLocaleUrl(lang, indexPath) }>{ t(lang, "release-notes.see-all") }</a>
      </div>
    )) }
  </section>
  <Footer slot="footer" />
</Layout>
