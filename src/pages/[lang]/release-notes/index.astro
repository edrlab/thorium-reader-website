---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "../../../layouts/Layout.astro";
import Footer from "../../../components/Footer.astro";
import { locales } from "../../../i18n/locales.js";
import { t, formatDate, localizeCollection } from "../../../i18n/utils.js";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.currentLocale ?? "en";

const allNotes = await getCollection("release-notes");
const platformIds = [...new Set(allNotes.map((n) => n.id.split("/")[0]))].sort((a, b) => a.localeCompare(b));

const platforms = platformIds.map((platform) => {
  const sorted = localizeCollection(allNotes, lang, platform).sort((a, b) => b.note.data.date.localeCompare(a.note.data.date));
  return {
    label: t(lang, `platform.names.${ platform }`) as string,
    indexPath: `release-notes/${ platform }/`,
    notes: sorted.slice(0, 5).map(({ slug, note }) => ({
      version: note.data.version,
      date: note.data.date,
      path: `release-notes/${ platform }/${ slug }`,
    })),
  };
});
---

<Layout title={ t(lang, "release-notes.title") }>
  <section class="release-notes-hub container">
    <h1>{ t(lang, "release-notes.title") }</h1>
    { platforms.map(({ label, indexPath, notes }) => (
      <div class="release-notes-hub-platform">
        <h2>{ label }</h2>
        <ul>
          { notes.map(({ version, date, path }) => (
            <li>
              <a href={ getRelativeLocaleUrl(lang, path) }>v{ version }</a>
              <time datetime={ date }>{ formatDate(lang, date) }</time>
            </li>
          )) }
        </ul>
        <a class="release-notes-hub-see-all" href={ getRelativeLocaleUrl(lang, indexPath) }>{ t(lang, "release-notes.see-all") }</a>
      </div>
    )) }
  </section>
  <Footer slot="footer" />
</Layout>
