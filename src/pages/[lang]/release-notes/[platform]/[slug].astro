---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../../../layouts/Layout.astro";
import Footer from "../../../../components/Footer.astro";
import { locales } from "../../../../i18n/locales.js";
import { formatDate, localizeCollection, getPlatforms } from "../../../../i18n/utils.js";

export async function getStaticPaths() {
  const notes = await getCollection("release-notes");
  const platforms = getPlatforms(notes);
  return locales.flatMap((lang) =>
    platforms.flatMap((platform) =>
      localizeCollection<CollectionEntry<"release-notes">>(notes, lang, platform).map(({ slug, note }) => ({
        params: { lang, platform, slug },
        props: { note },
      }))
    )
  );
}

const lang = Astro.currentLocale ?? "en";
const { note } = Astro.props;
const { Content } = await render(note);
---

<Layout title={ note.data.title }>
  <article class="platform-doc container">
    <h1>{ note.data.title }</h1>
    <time datetime={ note.data.date }>{ formatDate(lang, note.data.date) }</time>
    <Content />
  </article>
  <Footer slot="footer" />
</Layout>
