---
import Layout from "../../../layouts/Layout.astro";
import Footer from "../../../components/Footer.astro";
import PageHeader from "../../../components/sections/PageHeader.astro";
import Field from "../../../components/badge/Field.astro";
import PassphraseFields from "../../../components/badge/PassphraseFields.astro";
import BadgeLangSelector from "../../../components/badge/BadgeLangSelector.astro";
import BadgeOutput from "../../../components/badge/BadgeOutput.astro";
import ClientData from "../../../components/ClientData.astro";
import { t } from "../../../i18n/utils.js";
import { locales } from "../../../i18n/locales.js";
import { addPublicationUniversalLink, addPublicationScheme } from "../../../links.js";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.currentLocale;

const badgeTexts = Object.fromEntries(
  locales.map((l) => [l, {
    line1: t(l, "badge.shared.buttonLine1"),
    line2: t(l, "badge.shared.buttonLine2"),
    alt:   t(l, "badge.shared.alt"),
  }])
);
---

<Layout title={ t(lang, "badge.publication.header.title") + " — " + t(lang, "site.title") }>
  <PageHeader
    title={ t(lang, "badge.publication.header.title") }
    body={ t(lang, "badge.publication.header.subtitle") }
  />

  <section class="badge-section">
    <div class="container">
      <div class="badge-layout">

        <form id="badge-form" novalidate>
          <fieldset>
            <legend>{ t(lang, "badge.publication.form.legend") }</legend>

            <Field
              id="pub-publication"
              name="publication"
              type="url"
              label={ t(lang, "badge.publication.form.publication.label") }
              placeholder={ t(lang, "badge.publication.form.publication.placeholder") }
              hint={ t(lang, "badge.publication.form.publication.hint") }
              required
            />

            <Field
              id="pub-title"
              name="title"
              label={ t(lang, "badge.publication.form.title.label") }
              placeholder={ t(lang, "badge.publication.form.title.placeholder") }
              hint={ t(lang, "badge.publication.form.title.hint") }
              autocomplete="off"
            />

            <Field
              id="pub-author"
              name="author"
              label={ t(lang, "badge.publication.form.author.label") }
              placeholder={ t(lang, "badge.publication.form.author.placeholder") }
              hint={ t(lang, "badge.publication.form.author.hint") }
              autocomplete="off"
            />

            <Field
              id="pub-cover"
              name="cover"
              type="url"
              label={ t(lang, "badge.publication.form.cover.label") }
              placeholder={ t(lang, "badge.publication.form.cover.placeholder") }
              hint={ t(lang, "badge.publication.form.cover.hint") }
            />

            <PassphraseFields lang={ lang } />

            <BadgeLangSelector lang={ lang } locales={ locales } selectedValue={ lang } />
          </fieldset>
        </form>

        <BadgeOutput lang={ lang } />

      </div>
    </div>
  </section>

  <ClientData
    id="badge-data"
    data={{
      "data-badge-texts": JSON.stringify(badgeTexts),
      "data-universal-link": addPublicationUniversalLink,
      "data-scheme": addPublicationScheme,
    }}
  />

  <Footer slot="footer" />
</Layout>

<script>
  import { makeSVG, esc, publicationParamAttrs, publicationIsValid } from "../../../../packages/thorium-badges/src/badge-svg.js";
  import { interpolate } from "../../../i18n/utils.js";

  const dataEl                      = document.getElementById("badge-data");
  const badgeTexts                  = JSON.parse(dataEl.dataset.badgeTexts);
  const addPublicationUniversalLink = dataEl.dataset.universalLink;
  const addPublicationScheme        = dataEl.dataset.scheme;

  const form            = document.getElementById("badge-form");
  const previewEl       = document.getElementById("preview-badge");
  const embedCode       = document.getElementById("embed-code");
  const webcomponentCode = document.getElementById("webcomponent-code");
  const langSelect      = form.querySelector("[name=lang]");

  // The lang select is pre-filled with the generator page's own locale, not
  // an explicit user choice, so only emit the web component's "lang"
  // attribute once the visitor has actually interacted with that control.
  let langTouched = false;

  // Attribute names use the custom element's kebab-case convention (e.g.
  // "hashed-passphrase"); form field names use the matching snake_case.
  function get(attrName) {
    const fieldName = attrName.replace(/-/g, "_");
    const input = form.elements.namedItem(fieldName);
    if (!(input instanceof HTMLInputElement || input instanceof HTMLSelectElement || input instanceof HTMLTextAreaElement)) return "";
    const value = input.value.trim();
    return value && input.validity.valid ? value : "";
  }

  function update() {
    const selectedLang = form.querySelector("[name=lang]").value;
    const title        = get("title");

    const { line1, line2, alt } = badgeTexts[selectedLang] ?? Object.values(badgeTexts)[0];
    const svgTitle = title ? interpolate(alt, { name: title }) : `${ line1 } ${ line2 }`;

    const params = new URLSearchParams();
    for (const [attrName, paramName] of publicationParamAttrs) {
      const value = get(attrName);
      if (value) params.set(paramName, value);
    }

    const hasParams   = publicationIsValid(get);
    const previewLink = hasParams ? `${ addPublicationScheme }?${ params.toString() }` : null;
    const embedLink   = hasParams ? `${ addPublicationUniversalLink }?${ params.toString() }` : null;

    const svg = makeSVG({ line1, line2, title: svgTitle });

    previewEl.innerHTML = previewLink
      ? `<a href="${ esc(previewLink) }">${ svg }</a>`
      : svg;

    embedCode.textContent = embedLink
      ? `<a href="${ esc(embedLink) }">\n  ${ svg }\n</a>`
      : "";

    const wcAttrs = [...publicationParamAttrs.map(([attr]) => attr), "lang"]
      .map((attr) => [attr, attr === "lang" ? (langTouched ? selectedLang : "") : get(attr)])
      .filter(([, value]) => value)
      .map(([attr, value]) => `  ${ attr }="${ esc(value) }"`)
      .join("\n");

    webcomponentCode.textContent = hasParams
      ? `<thorium-badge-publication\n${ wcAttrs }\n></thorium-badge-publication>`
      : "";
  }

  form.addEventListener("input", (e) => {
    if (e.target === langSelect) langTouched = true;
    update();
  });
  update();
</script>
