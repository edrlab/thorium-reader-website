---
import Layout from "../../../layouts/Layout.astro";
import Footer from "../../../components/Footer.astro";
import PageHeader from "../../../components/sections/PageHeader.astro";
import Field from "../../../components/badge/Field.astro";
import SelectField from "../../../components/badge/SelectField.astro";
import FieldGroup from "../../../components/badge/FieldGroup.astro";
import PassphraseFields from "../../../components/badge/PassphraseFields.astro";
import BadgeLangSelector from "../../../components/badge/BadgeLangSelector.astro";
import BadgeOutput from "../../../components/badge/BadgeOutput.astro";
import ClientData from "../../../components/ClientData.astro";
import { t } from "../../../i18n/utils.js";
import { locales } from "../../../i18n/locales.js";
import { addCatalogUniversalLink } from "../../../links.js";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.currentLocale ?? "en";

const badgeTexts = Object.fromEntries(
  locales.map((l) => [l, {
    line1: t(l, "badge.shared.buttonLine1"),
    line2: t(l, "badge.shared.buttonLine2"),
    alt:   t(l, "badge.shared.alt"),
  }])
);

const colors = ["gray", "red", "yellow", "blue", "green", "purple", "orange", "pink"];
---

<Layout title={ t(lang, "badge.catalog.header.title") + " — " + t(lang, "site.title") }>
  <PageHeader
    title={ t(lang, "badge.catalog.header.title") }
    body={ t(lang, "badge.catalog.header.subtitle") }
  />

  <section class="badge-section">
    <div class="container">
      <div class="badge-layout">

        <form id="badge-form" novalidate>
          <fieldset>
            <legend>{ t(lang, "badge.catalog.form.legend") }</legend>

            <SelectField
              id="badge-integration"
              name="integration"
              label={ t(lang, "badge.shared.integration.label") }
              options={[
                { value: "link",         label: t(lang, "badge.shared.integration.link") },
                { value: "webcomponent", label: t(lang, "badge.shared.integration.webcomponent") },
              ]}
              selectedValue="link"
              hint={ t(lang, "badge.shared.integration.hint") }
            />

            <Field
              id="catalog-title"
              name="title"
              label={ t(lang, "badge.catalog.form.title.label") }
              placeholder={ t(lang, "badge.catalog.form.title.placeholder") }
              hint={ t(lang, "badge.catalog.form.title.hint") }
              required
              autocomplete="off"
            />

            <FieldGroup labelId="urls-label" legend={ t(lang, "badge.catalog.form.urls.legend") } required>
              <Field
                id="catalog-main"
                name="main"
                type="url"
                label={ t(lang, "badge.catalog.form.main.label") }
                placeholder={ t(lang, "badge.catalog.form.main.placeholder") }
                hint={ t(lang, "badge.catalog.form.main.hint") }
              />
              <Field
                id="catalog-bookshelf"
                name="bookshelf"
                type="url"
                label={ t(lang, "badge.catalog.form.bookshelf.label") }
                placeholder={ t(lang, "badge.catalog.form.bookshelf.placeholder") }
                hint={ t(lang, "badge.catalog.form.bookshelf.hint") }
              />
            </FieldGroup>

            <PassphraseFields lang={ lang } />

            <SelectField
              id="catalog-open-in"
              name="open_in"
              label={ t(lang, "badge.catalog.form.openIn.label") }
              options={[
                { value: "",        label: t(lang, "badge.catalog.form.openIn.default") },
                { value: "webview", label: t(lang, "badge.catalog.form.openIn.webview") },
                { value: "browser", label: t(lang, "badge.catalog.form.openIn.browser") },
              ]}
              selectedValue=""
              hint={ t(lang, "badge.catalog.form.openIn.hint") }
            />

            <Field
              id="catalog-icon"
              name="icon"
              type="url"
              label={ t(lang, "badge.catalog.form.icon.label") }
              placeholder={ t(lang, "badge.catalog.form.icon.placeholder") }
              hint={ t(lang, "badge.catalog.form.icon.hint") }
            />

            <Field
              id="catalog-banner"
              name="banner"
              type="url"
              label={ t(lang, "badge.catalog.form.banner.label") }
              placeholder={ t(lang, "badge.catalog.form.banner.placeholder") }
              hint={ t(lang, "badge.catalog.form.banner.hint") }
            />

            <SelectField
              id="catalog-color"
              name="color"
              label={ t(lang, "badge.catalog.form.color.label") }
              options={[
                { value: "", label: t(lang, "badge.catalog.form.color.default") },
                ...colors.map(c => ({
                  value: c,
                  label: t(lang, `badge.catalog.form.color.${ c }`),
                }))
              ]}
              selectedValue=""
              hint={ t(lang, "badge.catalog.form.color.hint") }
            />

            <BadgeLangSelector lang={ lang } locales={ locales } selectedValue={ lang } />
          </fieldset>
        </form>

        <BadgeOutput lang={ lang } />

      </div>
    </div>
  </section>

  <ClientData
    id="badge-data"
    data={{
      "data-badge-texts": JSON.stringify(badgeTexts),
      "data-universal-link": addCatalogUniversalLink,
    }}
  />

  <Footer slot="footer" />
</Layout>

<script>
  import { makeSVG, esc, catalogParamAttrs, catalogIsValid } from "../../../../packages/thorium-badges/src/badge-svg.js";
  import { interpolate } from "../../../i18n/utils.js";

  const dataEl                  = document.getElementById("badge-data") as HTMLElement;
  const badgeTexts              = JSON.parse(dataEl.dataset.badgeTexts!);
  const addCatalogUniversalLink = dataEl.dataset.universalLink;

  const form                      = document.getElementById("badge-form") as HTMLFormElement;
  const previewEl                 = document.getElementById("preview-badge") as HTMLElement;
  const embedCode                 = document.getElementById("embed-code") as HTMLElement;
  const embedCodeHintLink         = document.getElementById("embed-code-hint-link") as HTMLElement;
  const embedCodeHintWebcomponent = document.getElementById("embed-code-hint-webcomponent") as HTMLElement;
  const langSelect                = form.querySelector("[name=lang]") as HTMLInputElement;
  const integrationSelect         = form.querySelector("[name=integration]") as HTMLInputElement;

  // The "auto" language only makes sense for the web component (its text
  // renders client-side); the link/embed SVG bakes text in at generation
  // time, so it needs a concrete locale.
  const langWrapper      = (document.getElementById("badge-lang") as HTMLElement).closest("[data-custom-select]") as HTMLElement;
  const autoLangOption   = langWrapper.querySelector('[data-value="auto"]') as HTMLElement;
  const defaultLangValue = langWrapper.querySelector('[aria-selected="true"]')?.getAttribute("data-value") ?? "en";

  function setAutoLangAvailable(available: boolean) {
    autoLangOption.hidden = !available;
    const target = available
      ? autoLangOption
      : langWrapper.querySelector(`[data-value="${ defaultLangValue }"]`) as HTMLElement | null;
    target?.click();
  }

  // Attribute names use the custom element's kebab-case convention (e.g.
  // "hashed-passphrase"); form field names use the matching snake_case.
  function get(attrName: string) {
    const fieldName = attrName.replace(/-/g, "_");
    const input = form.elements.namedItem(fieldName);
    if (!(input instanceof HTMLInputElement || input instanceof HTMLSelectElement || input instanceof HTMLTextAreaElement)) return "";
    const value = input.value.trim();
    return value && input.validity.valid ? value : "";
  }

  function update() {
    const selectedLang   = langSelect.value;
    const isWebComponent = integrationSelect.value === "webcomponent";
    const title           = get("title");

    const { line1, line2, alt } = badgeTexts[selectedLang] ?? Object.values(badgeTexts)[0];
    const svgTitle = title ? interpolate(alt, { name: title }) : `${ line1 } ${ line2 }`;

    const params = new URLSearchParams();
    for (const [attrName, paramName] of catalogParamAttrs) {
      const value = get(attrName);
      if (value) params.set(paramName, value);
    }

    const hasParams = catalogIsValid(get);
    const link      = hasParams ? `${ addCatalogUniversalLink }?${ params.toString() }` : null;

    const svg = makeSVG({ line1, line2, title: svgTitle });

    previewEl.innerHTML = link
      ? `<a href="${ esc(link) }">${ svg }</a>`
      : svg;

    embedCodeHintLink.hidden = isWebComponent;
    embedCodeHintWebcomponent.hidden = !isWebComponent;

    if (isWebComponent) {
      const wcAttrs = [...catalogParamAttrs.map(([attr]) => attr), "lang"]
        .map((attr) => [attr, attr === "lang" ? selectedLang : get(attr)])
        .filter(([, value]) => value)
        .map(([attr, value]) => `  ${ attr }="${ esc(value) }"`)
        .join("\n");

      embedCode.textContent = hasParams
        ? `<thorium-badge-catalog\n${ wcAttrs }\n></thorium-badge-catalog>`
        : "";
    } else {
      embedCode.textContent = link
        ? `<a href="${ esc(link) }">\n  ${ svg }\n</a>`
        : "";
    }
  }

  form.addEventListener("input", (e) => {
    if (e.target === integrationSelect) setAutoLangAvailable(integrationSelect.value === "webcomponent");
    update();
  });
  setAutoLangAvailable(integrationSelect.value === "webcomponent");
  update();
</script>
