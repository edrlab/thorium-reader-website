---
import Layout from "../../layouts/Layout.astro";
import IntroSection from "../../components/sections/IntroSection.astro";
import StepsSection from "../../components/sections/StepsSection.astro";
import Footer from "../../components/Footer.astro";
import DownloadButton from "../../components/buttons/DownloadButton.astro";
import { t, getImage } from "../../i18n/utils.js";
import { locales } from "../../i18n/locales.js";
import { discordHref } from "../../config.js";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.currentLocale;
---

<Layout title={ t(lang, "install.intro.title") }>
  <IntroSection
    title={ t(lang, "install.intro.title") }
    body={ t(lang, "install.intro.subtitle") }
  >
    <DownloadButton slot="actions" href={`/${ lang }/download`} />
  </IntroSection>

  <StepsSection
    title={ t(lang, "install.steps.title") }
    items={ t(lang, "install.steps.items", { returnObjects: true }) as { title: string; body?: string }[] }
  />

  <Footer
    image={{ src: getImage(lang, "thorium-reader-mobile-option.webp"), alt: t(lang, "home.alts.thorium-reader-mobile-option") }}
    clip={true}
    discordHref={ discordHref }
  />
</Layout>
