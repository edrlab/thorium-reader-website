---
import BreakpointImage from "../../components/images/BreakpointImage.astro";
import Layout from "../../layouts/Layout.astro";
import PageHeader from "../../components/sections/PageHeader.astro";
import FeatureSection from "../../components/sections/FeatureSection.astro";
import ComicBookDecoration from "../../components/decorations/ComicBookDecoration.astro";
import TabsSection from "../../components/sections/TabsSection.astro";
import FAQ from "../../components/sections/FAQ.astro";
import Footer from "../../components/Footer.astro";
import AppStoreBadge from "../../components/buttons/AppStoreBadge.astro";
import MsStoreBadge from "../../components/buttons/MsStoreBadge.astro";
import ActionButton from "../../components/buttons/ActionButton.astro";
import { t, getImage, slugify } from "../../i18n/utils.js";
import { locales } from "../../i18n/locales.js";
import rawShape6WaveBottom from "../../assets/shapes/thorium-shape-6-wave-bottom.svg?raw";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.currentLocale;

function osSteps(key: string): string[] {
  const steps = t(lang, `download.modal.${ key }.steps`, { returnObjects: true });
  return Array.isArray(steps) ? steps : [];
}

const tabLabels = t(lang, "download.modal.tab", { returnObjects: true }) as Record<string, string>;
const osTabs = Object.entries(tabLabels).map(([key, label]) => ({ id: slugify(key), key, label }));
---

<Layout noBlob>
  <PageHeader class="download-page-header" title={ t(lang, "download.hero.title") } />

  <FeatureSection
    id="desktop"
    title={ t(lang, "download.desktop.title") }
    body={ t(lang, "download.desktop.body") }
    reverse
    textAlign="left"
  >
    <div slot="actions" class="desktop-actions">
      <MsStoreBadge />
      <ActionButton variant="accent" label={ t(lang, "button.releaseNotes") } href={`${ import.meta.env.BASE_URL }${ lang }/release-notes/desktop`} />
    </div>
  </FeatureSection>

  <TabsSection
    class="download-tabs-section"
    id="download-tabs"
    tabs={ osTabs }
    label={ t(lang, "download.tabs.label") }
  >
    <ComicBookDecoration slot="border-top" lang={ lang } />

    { osTabs.map((tab, i) => {
      const steps = osSteps(tab.key);
      return (
        <div
          id={`panel-${ tab.id }`}
          role="tabpanel"
          aria-labelledby={ tab.id }
          tabindex={ 0 }
          hidden={ i !== 0 }
        >
          { steps.length > 0
            ? <ul class="download-steps">
                { steps.map(s => <li set:html={ s } />) }
              </ul>
            : <p class="download-steps-todo">{ t(lang, "download.coming_soon") }</p>
          }
        </div>
      );
    }) }

    <div slot="border-bottom" class="tabs-wave tabs-wave-bottom" aria-hidden="true">
      <Fragment set:html={ rawShape6WaveBottom } />
    </div>
  </TabsSection>

  <FeatureSection
    id="ios"
    title={ t(lang, "download.ios.title") }
    body={ t(lang, "download.ios.body") }
    fullWidth
  >
    <AppStoreBadge slot="actions" />
    <figure>
      <BreakpointImage
        sources={[
          { src: getImage(lang, "thorium-mobile-download-screens-compact.webp"), alt: t(lang, "home.alts.thorium-mobile-download-screens-compact"), media: "(max-width: 768px)" },
          { src: getImage(lang, "thorium-mobile-download-screens-large.webp"),   alt: t(lang, "home.alts.thorium-mobile-download-screens-large") },
        ]}
      />
    </figure>
  </FeatureSection>

  <FAQ
    title={ t(lang, "download.faq.title") }
    items={ t(lang, "download.faq.items", { returnObjects: true }) as { question: string; answer: string; items?: string[] }[] }
    class="bottom-gap"
  />

  <Footer slot="footer" />
</Layout>

<script define:vars={{ tabIds: osTabs.map(t => t.id) }}>
  function slugify(str) {
    return str
      .toLowerCase()
      .normalize("NFD")
      .replace(/[̀-ͯ]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "");
  }

  function activateFromHash() {
    const id = slugify(location.hash.slice(1));
    if (!tabIds.includes(id)) return;
    document.getElementById(id)?.click();
  }

  activateFromHash();
  window.addEventListener("hashchange", activateFromHash);
</script>
