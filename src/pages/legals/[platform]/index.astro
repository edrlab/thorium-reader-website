---
import { getCollection } from "astro:content";
import LocaleRedirect from "../../../components/LocaleRedirect.astro";

export async function getStaticPaths() {
  const docs = await getCollection("platform-conformance");
  const platforms = [...new Set(docs.map((doc) => doc.id.split("/")[0]))]
    .filter((platform) => platform !== "desktop")
    .sort((a, b) => a.localeCompare(b));

  return platforms.map((platform) => ({
    params: { platform },
  }));
}

const platform = Astro.params.platform;
---
<LocaleRedirect path={ `legals/${ platform }/` } />
