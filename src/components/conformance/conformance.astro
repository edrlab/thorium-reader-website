---
import sanitizeHtml from "sanitize-html";

const sanitize = (html) => sanitizeHtml(html ?? "", {
	allowedTags: ["a", "code", "em", "li", "ol", "p", "strong", "ul"],
	allowedAttributes: { "a": ["href", "target", "rel"] },
	allowedSchemes: ["http", "https"],
});

const {
	reportedPlatform,
	index = {},
	productName,
	version,
	platform,
	reportDate,
	evaluationDate,
	changelog,
	testingMethodology,
	standards,
} = Astro.props;

const platformData = reportedPlatform || "desktop";
const platformConformanceData = index?.conformance?.[platformData] ?? {};
const changelogData = platformConformanceData.changelog ?? changelog;
const conformanceSummary = platformConformanceData.conformanceSummary;
const methodologyData =
	platformConformanceData.testingMethodology ?? testingMethodology;
const standardsToShow =
	Array.isArray(standards) && standards.length > 0
		? standards
		: ["wcag", "uaag", "epub", "daisyURS"];
const legacyRulesets = platformConformanceData.rulesets;

const getSetData = (standard) => {
	const value = platformConformanceData?.[standard];

	if (Array.isArray(value)) {
		return {
			ruleset: legacyRulesets?.[standard],
			rules: value,
		};
	}

	if (value && typeof value === "object") {
		return {
			ruleset: value.ruleset ?? legacyRulesets?.[standard],
			rules: Array.isArray(value.rules) ? value.rules : [],
		};
	}

	return {
		ruleset: legacyRulesets?.[standard],
		rules: [],
	};
};

const rulesets = Object.fromEntries(
	standardsToShow
		.map((standard) => {
			const setData = getSetData(standard);
			return [standard, setData.ruleset];
		})
		.filter(([, ruleset]) => Boolean(ruleset)),
);

const sortById = (items = []) => {
	return [...items].sort((a, b) => {
		const aId = Number(a?.id);
		const bId = Number(b?.id);

		if (Number.isFinite(aId) && Number.isFinite(bId)) {
			return aId - bId;
		}

		return String(a?.id ?? "").localeCompare(String(b?.id ?? ""), undefined, {
			numeric: true,
			sensitivity: "base",
		});
	});
};
---

<section class="conformance-report">
{conformanceSummary && (
			<p class="conformance-summary"><em>{conformanceSummary}</em></p>
		)}
	<section id="about-report">
		<h2>About This Report</h2>

		<dl>
			<dt>Product Name:</dt>
			<dd>{platformConformanceData.productName || productName}</dd>
			<dt>Version:</dt>
			<dd>{platformConformanceData.version || version}</dd>
			<dt>Platform:</dt>
			<dd>{platformConformanceData.platform || platform}</dd>
            <!--		
            <dt>Report Date:</dt>
			<dd>{platformConformanceData.reportDate || reportDate}</dd>
            -->
			<dt>Evaluation Date:</dt>
			<dd>{platformConformanceData.evaluationDate || evaluationDate}</dd>
		</dl>



		<details>
			<summary>Changelog</summary>
			{Array.isArray(changelogData) && changelogData.length > 0 ? (
				<ul>
					{changelogData.map((entry) => (
						<li>
							<strong>{entry.date}:</strong> {entry.description}
						</li>
					))}
				</ul>
			) : (
				<p>No changelog available yet.</p>
			)}
		</details>

		<details>
			<summary>
            More about this evaluation
			</summary>
				<h3 class="inline">Evaluation Methodology</h3>
			{methodologyData ? (
				<>
					{methodologyData.methodology && (
						<p>
							<strong>{methodologyData.methodology}</strong>
						</p>
					)}

					{Array.isArray(methodologyData.testingApproaches) &&
						methodologyData.testingApproaches.length > 0 && (
							<>
								<h3>Testing Approaches</h3>
								<ul>
									{methodologyData.testingApproaches.map((approach) => (
										<li>{approach}</li>
									))}
								</ul>
							</>
						)}

					{Array.isArray(methodologyData.testedScenarios) &&
						methodologyData.testedScenarios.length > 0 && (
							<>
								<h4>Tested Scenarios</h4>
								<ul>
									{methodologyData.testedScenarios.map((scenario) => (
										<li>
											<strong>{scenario.date}:</strong>{" "}
											{scenario.url ? (
												<a href={scenario.url} target="_blank" rel="noreferrer">
													{scenario.scenario}
												</a>
											) : (
												scenario.scenario
											)}
										</li>
									))}
								</ul>
							</>
						)}
				</>
			) : (
				<p>No testing methodology information available.</p>
			)}

			<h3 class="inline">Standards &amp; References</h3>

			{rulesets && (
				<dl>
					{Object.entries(rulesets).map(([, ruleset]) => (
						<>
							<dt>
								{ruleset.title} ({ruleset.name})
							</dt>
							<dd>
								Version: {ruleset.version} - Reference:{" "}
								<a href={ruleset.referenceUrl} target="_blank" rel="noreferrer">
									{ruleset.referenceUrl}
								</a>
							</dd>
						</>
					))}
				</dl>
			)}
		</details>
	</section>

	<hr />

	<section id="conformance" class="js-tabs">
		<h2>Detailed Reports</h2>

		{standardsToShow.map((standard) => {
			const setData = getSetData(standard);
			const standardData = setData.rules;
			const sortedData = sortById(standardData);

			if (!sortedData.length) {
				return null;
			}

			return (
				<section class="report-section">
                <h3 class="inline">{String(standard).toUpperCase()} Conformance Results</h3>
{conformanceSummary && (
			<p class="conformance-summary"><em>{conformanceSummary}</em></p>
		)}
					<details>
						<summary>{String(standard).toUpperCase()} Conformance Details</summary>
						<table class="responsive" id={`${standard}-results`}>
							<caption class="sr-only">
								{String(standard).toUpperCase()} conformance results
								<span> (column headers with buttons are sortable).</span>
							</caption>
							<thead>
								<tr>
									<th class="sortable" data-priority="1">
										<button type="button" class="sortable-trigger">
											<span>Success Criteria</span>
											<span class="sort-icon" aria-hidden="true">♢</span>
										</button>
									</th>
									<th class="sortable">
										<button type="button" class="sortable-trigger">
											<span>Level</span>
											<span class="sort-icon" aria-hidden="true">♢</span>
										</button>
									</th>
									<th class="sortable" data-priority="2">
										<button type="button" class="sortable-trigger">
											<span>Result</span>
											<span class="sort-icon" aria-hidden="true">♢</span>
										</button>
									</th>
									<th class="sortable">
										<button type="button" class="sortable-trigger">
											<span>Notes</span>
											<span class="sort-icon" aria-hidden="true">♢</span>
										</button>
									</th>
								</tr>
							</thead>
							<tbody>
								{sortedData.map((item) => (
									<tr>
										<td data-order={item.id}>
											<details>
											<summary class="sc-title" id={`sc_${standard}_${item.id}`}>
													{item.number} {item.title}
												</summary>
												<p class="sc-text" set:html={sanitize(item.description)} />
												<p class="issue">
													<a href={item.url} target="_blank" rel="noreferrer">
														{item.title}
													</a>
												</p>
											</details>
										</td>
										<td class="lvl">{item.level}</td>
										<td class={`result ${String(item.result ?? "").toLowerCase()}`}>
											<p class="label">{item.result}</p>
										</td>
										<td>
											{item.notes && <div class="notes" set:html={sanitize(item.notes)} />}
											{item.additionalInfo && <p class="notes">{item.additionalInfo}</p>}
											{item.issue && item.issuelabel ? (
												<p class="issue">
													<a href={item.issue} target="_blank" rel="noreferrer">
														{item.issuelabel}
													</a>
												</p>
											) : (
												item.issue && (
													<p class="issue">
														<a href={item.issue} target="_blank" rel="noreferrer">
															{item.issue}
														</a>
													</p>
												)
											)}
										</td>
									</tr>
								))}
							</tbody>
						</table>
					</details>
				</section>
			);
		})}
	</section>
</section>

<script>
	document.addEventListener("DOMContentLoaded", function () {
		const collator = new Intl.Collator(undefined, {
			numeric: true,
			sensitivity: "base",
		});

		const getCellValue = (row, index) => {
			const cell = row.cells[index];
			if (!cell) return "";

			const orderValue = cell.getAttribute("data-order");
			if (orderValue !== null) {
				return orderValue.trim();
			}

			return (cell.textContent || "").trim();
		};

		const compareValues = (a, b) => {
			const numA = Number(a);
			const numB = Number(b);

			if (Number.isFinite(numA) && Number.isFinite(numB)) {
				return numA - numB;
			}

			return collator.compare(String(a), String(b));
		};

		for (const table of document.querySelectorAll("table.responsive")) {
			const tbody = table.tBodies[0];
			if (!tbody) continue;

			const headers = Array.from(table.querySelectorAll("thead th.sortable"));
			headers.forEach((header, index) => {
				const trigger = header.querySelector("button.sortable-trigger");
				if (!trigger) return;

				const sort = () => {
					const currentDir = header.dataset.sortDir === "asc" ? "asc" : "desc";
					const nextDir = currentDir === "asc" ? "desc" : "asc";

					headers.forEach((h) => {
						h.dataset.sortDir = "";
						h.classList.remove("sorted-asc", "sorted-desc");
						h.removeAttribute("aria-sort");
					});

					header.dataset.sortDir = nextDir;
					header.classList.add(nextDir === "asc" ? "sorted-asc" : "sorted-desc");
					header.setAttribute("aria-sort", nextDir === "asc" ? "ascending" : "descending");

					const rows = Array.from(tbody.rows).map((row, originalIndex) => ({
						row,
						originalIndex,
						value: getCellValue(row, index),
					}));

					rows.sort((left, right) => {
						const cmp = compareValues(left.value, right.value);
						if (cmp !== 0) {
							return nextDir === "asc" ? cmp : -cmp;
						}
						return left.originalIndex - right.originalIndex;
					});

					for (const { row } of rows) {
						tbody.appendChild(row);
					}
				};

				trigger.addEventListener("click", sort);
			});
		}
	});
</script>
