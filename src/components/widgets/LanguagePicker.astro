---
import { getRelativeLocaleUrl } from "astro:i18n";
import { locales } from "../../i18n/locales.js";
import CustomSelect from "./CustomSelect.astro";

const currentLocale = Astro.currentLocale ?? "en";
const withoutBase = Astro.url.pathname.slice(import.meta.env.BASE_URL.length);
const segments = withoutBase.split("/").filter(Boolean);
const currentPath = "/" + segments.slice(1).join("/");

const labels: Record<string, string> = {
  en: "English",
  fr: "Français",
};

const options = locales.map(code => ({
  value: code,
  label: labels[code] ?? code.toUpperCase(),
  url: getRelativeLocaleUrl(code, currentPath),
}));
---

<CustomSelect
  options={options}
  selectedValue={currentLocale}
  label={`Language: ${labels[currentLocale] ?? currentLocale.toUpperCase()}`}
  class="lang-picker"
/>
