---
import { getRelativeLocaleUrl } from "astro:i18n";
import { locales } from "../../i18n/locales.js";
import { t, localeName } from "../../i18n/utils.js";
import CustomSelect from "./CustomSelect.astro";

const currentLocale = Astro.currentLocale ?? "en";
const withoutBase = Astro.url.pathname.slice(import.meta.env.BASE_URL.length);
const segments = withoutBase.split("/").filter(Boolean);
const currentPath = "/" + segments.slice(1).join("/");

const options = locales.map(code => ({
  value: code,
  label: localeName(code, code),
}));

const urls = Object.fromEntries(locales.map(code => [code, getRelativeLocaleUrl(code, currentPath)]));
---

<CustomSelect
  options={ options }
  selectedValue={ currentLocale }
  label={ `${ t(currentLocale, "lang.label") }: ${ localeName(currentLocale, currentLocale) }` }
  class="lang-picker"
  data-urls={ JSON.stringify(urls) }
/>

<script>
  document.querySelectorAll<HTMLElement>(".lang-picker[data-custom-select]").forEach(el => {
    const urls: Record<string, string> = JSON.parse(el.dataset.urls ?? "{}");
    el.addEventListener("cs-select", (e) => {
      const url = urls[(e as CustomEvent).detail.value];
      if (url) window.location.href = url;
    });
  });
</script>
