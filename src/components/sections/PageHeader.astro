---
interface Props {
  title: string;
  body?: string;
  class?: string;
}

const { title, body, class: className } = Astro.props;
---

<section class:list={["page-header", className]}>
  <div class="container">
    <h1>{ title }</h1>
    { body && <p>{ body }</p> }
    <slot />
  </div>
</section>
