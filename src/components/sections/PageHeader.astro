---
interface Props {
  title: string;
  body?: string | string[];
  class?: string;
}

const { title, body, class: className } = Astro.props;
---

<section class:list={["page-header", className]}>
  <div class="container">
    <h1>{ title }</h1>
    { body && (Array.isArray(body) ? body : [body]).map((p) => <p>{ p }</p>) }
    <slot />
  </div>
</section>
