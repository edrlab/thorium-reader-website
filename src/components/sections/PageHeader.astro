---
import BodyBlocks, { type BodyBlock } from "./BodyBlocks.astro";

interface Props {
  title: string;
  body?: string | BodyBlock[];
  class?: string;
}

const { title, body, class: className } = Astro.props;
const blocks = body ? (Array.isArray(body) ? body : [body]) : [];
---

<header class:list={["page-header", className]}>
  <h1>{ title }</h1>
  <BodyBlocks blocks={ blocks } />
  <slot />
</header>
