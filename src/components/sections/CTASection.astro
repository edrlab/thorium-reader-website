---
import BodyBlocks, { type BodyBlock } from "./BodyBlocks.astro";

interface Props {
  title: string;
  body: string | BodyBlock[];
}

const { title, body } = Astro.props;
const blocks = Array.isArray(body) ? body : [body];
---

<section class="cta-section">
  <slot name="border-top" />

  <div class="cta-inner">
    <div class="container cta-text">
      <h2>{ title }</h2>
      <BodyBlocks blocks={ blocks } />
      <slot name="actions" />
    </div>
  </div>

  <slot name="border-bottom" />

  <div class="cta-devices">
    <slot name="media" />
  </div>
</section>
