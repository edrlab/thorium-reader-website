---
interface Props {
  title: string;
  body: string | string[];
}

const { title, body } = Astro.props;
const paragraphs = Array.isArray(body) ? body : [body];
---

<section class="cta-section">
  <slot name="border-top" />

  <div class="cta-inner">
    <div class="container cta-text">
      <h2>{ title }</h2>
      { paragraphs.map((p) => <p>{ p }</p>) }
      <slot name="actions" />
    </div>
  </div>

  <slot name="border-bottom" />

  <div class="cta-devices">
    <slot name="media" />
  </div>
</section>
