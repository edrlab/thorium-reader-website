---
interface Props {
  title: string;
  body: string;
}

const { title, body } = Astro.props;
---

<section class="cta-section">
  <slot name="border-top" />

  <div class="cta-inner">
    <div class="container cta-text">
      <h2>{ title }</h2>
      <p>{ body }</p>
      <slot name="actions" />
    </div>
  </div>

  <slot name="border-bottom" />

  <div class="cta-devices">
    <slot name="media" />
  </div>
</section>
