---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  blob: string;
  illustration: { src: ImageMetadata; alt?: string };
}

const { blob, illustration } = Astro.props;
---

<div class="feature-decoration" aria-hidden="true">
  <div class="feature-blob"><Fragment set:html={blob} /></div>
  <Image
    class="feature-decoration-illustration"
    src={illustration.src}
    alt={illustration.alt ?? ""}
  />
</div>
