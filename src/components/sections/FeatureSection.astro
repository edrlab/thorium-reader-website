---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  body: string;
  illustration?: { src: ImageMetadata; alt?: string };
  reverse?: boolean;
}

const { title, body, illustration, reverse = false } = Astro.props;
---

<section class="feature-section">
  <slot name="blob" />

  <div class:list={["container feature-top", { reverse }]}>
    { illustration && (
      <Image
        class="feature-illustration"
        src={illustration.src}
        alt={illustration.alt ?? ""}
      />
    ) }

    <div class="feature-text">
      <h2>{ title }</h2>
      <p>{ body }</p>
      <slot name="actions" />
    </div>
  </div>

  <slot />
</section>
