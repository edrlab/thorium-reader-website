---
import BodyBlocks, { type BodyBlock } from "./BodyBlocks.astro";

interface Props {
  id?: string;
  class?: string;
  title: string;
  body: string | BodyBlock[];
  reverse?: boolean;
  textAlign?: "left" | "right";
  fullWidth?: boolean;
}

const { id, class: className, title, body, reverse = false, textAlign, fullWidth = false } = Astro.props;
const blocks = Array.isArray(body) ? body : [body];
---

<section class:list={["feature-section", className]} id={ id }>
  { fullWidth
    ? <div class="container feature-text">
        <h2>{ title }</h2>
        <BodyBlocks blocks={ blocks } />
        <slot name="actions" />
      </div>
    : <div
        class:list={["container feature-top", { reverse }]}
        data-text-align={ textAlign }
      >
        <div class="feature-text">
          <h2>{ title }</h2>
          <BodyBlocks blocks={ blocks } />
          <slot name="actions" />
        </div>
      </div>
  }

  <slot />

  <slot name="decoration" />
</section>
