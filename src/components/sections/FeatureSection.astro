---
interface Props {
  title: string;
  body: string;
  reverse?: boolean;
}

const { title, body, reverse = false } = Astro.props;
---

<section class="feature-section">
  <div class:list={["container feature-top", { reverse }]}>
    <div class="feature-text">
      <h2>{ title }</h2>
      <p>{ body }</p>
      <slot name="actions" />
    </div>
  </div>

  <slot />
</section>
