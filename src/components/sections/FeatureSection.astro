---
interface Props {
  id?: string;
  title: string;
  body: string;
  reverse?: boolean;
  textAlign?: "left" | "right";
  fullWidth?: boolean;
}

const { id, title, body, reverse = false, textAlign, fullWidth = false } = Astro.props;
---

<section class="feature-section" id={ id }>
  { fullWidth
    ? <div class="container feature-text">
        <h2>{ title }</h2>
        <p>{ body }</p>
        <slot name="actions" />
      </div>
    : <div
        class:list={["container feature-top", { reverse }]}
        data-text-align={ textAlign }
      >
        <div class="feature-text">
          <h2>{ title }</h2>
          <p>{ body }</p>
          <slot name="actions" />
        </div>
      </div>
  }

  <slot />

  <slot name="decoration" />
</section>
