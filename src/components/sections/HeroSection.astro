---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BlobOverlay from "../blobs/BlobOverlay.astro";

interface Props {
  title: string;
  body: string;
  image: { src: ImageMetadata; alt: string };
  clipImage?: boolean;
}

const { title, body, image, clipImage = false } = Astro.props;
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <h1>{ title }</h1>
      <p>{ body }</p>
      <slot name="actions" />
    </div>

    <div class="hero-image-wrap">
      <Image
        src={ image.src }
        alt={ image.alt }
      />
    </div>
  </div>
</section>

{ clipImage && <BlobOverlay /> }
