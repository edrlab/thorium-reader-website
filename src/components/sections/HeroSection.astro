---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import BlobOverlay from "../blobs/BlobOverlay.astro";
import shapeCompactRaw from "../../assets/shapes/thorium-shape-1-compact.svg?raw";

interface Props {
  title: string;
  body: string | string[];
  image: { src: ImageMetadata; alt: string };
  clipImage?: boolean;
}

const { title, body, image, clipImage = false } = Astro.props;
const paragraphs = Array.isArray(body) ? body : [body];
const compactMaskSvg = shapeCompactRaw.replace("currentColor", "black");
const compactMaskUrl = `data:image/svg+xml,${encodeURIComponent(compactMaskSvg)}`;
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <h1>{ title }</h1>
      { paragraphs.map((p) => <p>{ p }</p>) }
      <slot name="actions" />
    </div>

    <div
      class={ `hero-image-wrap${ clipImage ? " hero-image-wrap--clipped" : "" }` }
      style={ `--compact-mask: url('${compactMaskUrl}')` }
    >
      <div class="hero-wave-bg" aria-hidden="true"></div>
      <Image
        src={ image.src }
        alt={ image.alt }
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

{ clipImage && <BlobOverlay /> }
