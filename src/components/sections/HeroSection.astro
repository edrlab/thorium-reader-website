---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import BlobOverlay from "../blobs/BlobOverlay.astro";
import shapeCompact from "../../assets/shapes/thorium-shape-1-compact.webp";

interface Props {
  title: string;
  body: string;
  image: { src: ImageMetadata; alt: string };
  clipImage?: boolean;
}

const { title, body, image, clipImage = false } = Astro.props;
const compactProcessed = await getImage({ src: shapeCompact });
---

<section class="hero">
  <div class="container hero-inner">
    <div class="hero-text">
      <h1>{ title }</h1>
      <p>{ body }</p>
      <slot name="actions" />
    </div>

    <div
      class={ `hero-image-wrap${ clipImage ? " hero-image-wrap--clipped" : "" }` }
      style={ `--compact-mask: url('${compactProcessed.src}')` }
    >
      <div class="hero-wave-bg" aria-hidden="true"></div>
      <Image
        src={ image.src }
        alt={ image.alt }
      />
    </div>
  </div>
</section>

{ clipImage && <BlobOverlay /> }
