---
import FeatureDecoration from "./FeatureDecoration.astro";
import rawShape2 from "../../assets/shapes/thorium-shape-2.svg?raw";
import { getImage, t } from "../../i18n/utils.js";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
---

<FeatureDecoration
  class="book-walker-decoration"
  illustrationClass="book-walker-illustration"
  blob={ rawShape2 }
  illustration={{ src: getImage(lang, "thorium-illustration-02.webp"), alt: t(lang, "home.alts.thorium-illustration-02") }}
/>
