---
import type { ImageMetadata } from "astro";
import SizedImage from "../images/SizedImage.astro";

interface Props {
  blob: string | ImageMetadata;
  illustration: { src: ImageMetadata; alt?: string };
  class?: string;
  illustrationClass?: string;
  widths?: number[];
  sizes?: string;
}

const { blob, illustration, class: className, illustrationClass, widths, sizes } = Astro.props;
const blobIsImage = typeof blob !== "string";
---

<div class:list={ ["feature-decoration", className] } aria-hidden="true">
  <div class="feature-blob">
    { blobIsImage
      ? <SizedImage src={ blob as ImageMetadata } alt="" />
      : <Fragment set:html={ blob } />
    }
  </div>
  <SizedImage
    class:list={ ["feature-decoration-illustration", illustrationClass] }
    src={ illustration.src }
    alt={ illustration.alt ?? "" }
    widths={ widths }
    sizes={ sizes }
  />
</div>
