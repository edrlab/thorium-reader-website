---
import CTADecoration from "./CTADecoration.astro";
import { getImage } from "../../i18n/utils.js";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
---

<CTADecoration
  class="tipped-box-decoration"
  illustrationClass="tipped-box-illustration"
  illustration={{ src: getImage(lang, "thorium-illustration-03.webp") }}
  widths={ [160, 240, 320, 480] }
  sizes="160px"
/>
