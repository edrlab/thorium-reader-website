---
import { previewColors } from "../../../packages/thorium-badges/src/preview-colors.js";
import brokenImageIcon from "./assets/icons/broken_image.svg?raw";

interface Props {
  id?: string;
  type: "publication" | "catalog";
  titleFallback: string;
}

const { id = "entry-preview", type, titleFallback } = Astro.props;
const { foreground, backgroundStart, backgroundEnd } = previewColors.gray;
---

<div
  id={ id }
  class="entry-preview"
  data-type={ type }
  data-title-fallback={ titleFallback }
  style={`--preview-fg:${ foreground };--preview-bg-start:${ backgroundStart };--preview-bg-end:${ backgroundEnd }`}
>
  <span class="entry-preview-image">
    <img class="entry-preview-image-img" alt="" hidden />
    <span class="entry-preview-image-placeholder" aria-hidden="true" set:html={ brokenImageIcon }></span>
  </span>
  <div class="entry-preview-text">
    <p class="entry-preview-title"></p>
    <p class="entry-preview-author" hidden></p>
  </div>
</div>

<script>
  import { previewColors } from "../../../packages/thorium-badges/src/preview-colors.js";

  function isHttpUrl(value: string): boolean {
    try {
      return ["http:", "https:"].includes(new URL(value).protocol);
    } catch {
      return false;
    }
  }

  document.querySelectorAll<HTMLElement>(".entry-preview[data-type]").forEach((el) => {
    const type = el.dataset.type;
    const titleFallback = el.dataset.titleFallback ?? "";
    const params = new URLSearchParams(window.location.search);

    const titleEl = el.querySelector<HTMLElement>(".entry-preview-title");
    if (titleEl) titleEl.textContent = params.get("title") || titleFallback;

    if (type === "publication") {
      const author = params.get("author");
      const authorEl = el.querySelector<HTMLElement>(".entry-preview-author");
      if (authorEl && author) {
        authorEl.textContent = author;
        authorEl.hidden = false;
      }
    }

    if (type === "catalog") {
      const color = params.get("color");
      if (color && Object.hasOwn(previewColors, color)) {
        const { foreground, backgroundStart, backgroundEnd } = previewColors[color];
        el.style.setProperty("--preview-fg", foreground);
        el.style.setProperty("--preview-bg-start", backgroundStart);
        el.style.setProperty("--preview-bg-end", backgroundEnd);
      }
    }

    const imageParam = type === "publication" ? params.get("cover") : params.get("icon");
    const img = el.querySelector<HTMLImageElement>(".entry-preview-image-img");
    const placeholder = el.querySelector<HTMLElement>(".entry-preview-image-placeholder");
    if (img && placeholder && imageParam && isHttpUrl(imageParam)) {
      // Keep the placeholder showing until the image actually finishes loading,
      // rather than revealing it optimistically and risking a flash of a broken
      // image icon if the URL turns out not to be fetchable.
      img.addEventListener("load", () => {
        img.hidden = false;
        placeholder.setAttribute("hidden", "");
      });
      img.addEventListener("error", () => {
        img.hidden = true;
        placeholder.removeAttribute("hidden");
      });
      img.src = imageParam;
    }
  });
</script>
