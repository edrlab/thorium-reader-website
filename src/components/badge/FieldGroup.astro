---
interface Props {
  labelId: string;
  legend: string;
  required?: boolean;
}

const { labelId, legend, required } = Astro.props;
---

<div role="group" aria-labelledby={ labelId } class="field-group">
  <p id={ labelId } class="field-group-label">
    { legend }{ required && <span class="required" aria-hidden="true">*</span> }
  </p>
  <slot />
</div>
