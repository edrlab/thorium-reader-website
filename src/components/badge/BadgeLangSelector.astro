---
import SelectField from "./SelectField.astro";
import { t, localeName } from "../../i18n/utils.js";

interface Props {
  lang: string;
  locales: readonly string[];
  selectedValue: string;
}

const { lang, locales, selectedValue } = Astro.props;
---

<SelectField
  id="badge-lang"
  name="lang"
  label={ t(lang, "badge.shared.lang.label") }
  options={[
    { value: "auto", label: t(lang, "badge.shared.lang.auto") },
    ...locales.map((l) => ({ value: l, label: localeName(lang, l) })),
  ]}
  selectedValue={ selectedValue }
/>
