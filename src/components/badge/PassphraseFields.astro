---
import Field from "./Field.astro";
import FieldGroup from "./FieldGroup.astro";
import { t } from "../../i18n/utils.js";

interface Props {
  lang: string;
}

const { lang } = Astro.props;
---

<FieldGroup labelId="passphrase-label" legend={ t(lang, "badge.shared.passphrase.legend") }>
  <Field
    id="passphrase"
    name="passphrase"
    label={ t(lang, "badge.shared.passphrase.label") }
    placeholder={ t(lang, "badge.shared.passphrase.placeholder") }
    hint={ t(lang, "badge.shared.passphrase.hint") }
    autocomplete="off"
  />
  <Field
    id="passphrase-hash"
    name="hashed_passphrase"
    label={ t(lang, "badge.shared.passphraseHash.label") }
    placeholder={ t(lang, "badge.shared.passphraseHash.placeholder") }
    hint={ t(lang, "badge.shared.passphraseHash.hint") }
    autocomplete="off"
  />
</FieldGroup>
