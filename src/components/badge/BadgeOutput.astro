---
import Tabs from "../widgets/Tabs.astro";
import { t } from "../../i18n/utils.js";

interface Props {
  lang: string;
}

const { lang } = Astro.props;

const copyText   = t(lang, "badge.shared.output.copy");
const copiedText = t(lang, "badge.shared.output.copied");
---

<div class="badge-output" aria-live="polite">
  <Tabs
    tabs={[
      { id: "preview", label: t(lang, "badge.shared.preview.title") },
      { id: "code",    label: t(lang, "badge.shared.output.title") },
    ]}
    label={ t(lang, "badge.shared.output.title") }
  >
    <div id="panel-preview" role="tabpanel" aria-labelledby="preview" tabindex="0">
      <p class="field-hint">{ t(lang, "badge.shared.preview.hint") }</p>
      <div class="preview-display">
        <div id="preview-badge" aria-hidden="true"></div>
      </div>
    </div>

    <div id="panel-code" role="tabpanel" aria-labelledby="code" tabindex="0" hidden>
      <p class="field-hint">{ t(lang, "badge.shared.output.hint") }</p>
      <div class="embed-code-wrap">
        <pre><code id="embed-code"></code></pre>
        <button type="button" id="copy-btn" class="btn badge-copy-btn">
          { copyText }
        </button>
      </div>
    </div>
  </Tabs>
</div>

<script is:inline>
  function esc(s) {
    return String(s)
      .replace(/&/g, "&amp;")
      .replace(/"/g, "&quot;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;");
  }

  const _badgeSVGFont = 'font-family="system-ui,-apple-system,Arial,sans-serif"';

  function makeSVG({ line1, line2, title, iconUri }) {
    const iconPart = `<clipPath id="ic"><rect x="12" y="12" width="32" height="32" rx="5"/></clipPath>\n  <image href="${ iconUri }" x="12" y="12" width="32" height="32" clip-path="url(#ic)" preserveAspectRatio="xMidYMid meet"/>`;
    return [
      `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 196 56" width="196" height="56" role="img" aria-label="${ esc(title) }">`,
      `  <title>${ esc(title) }</title>`,
      `  <rect width="196" height="56" rx="8" fill="#A4485F"/>`,
      `  ${ iconPart }`,
      `  <text x="57" y="22" ${ _badgeSVGFont } font-size="10" fill="#F9F4E3" opacity="0.85">${ esc(line1) }</text>`,
      `  <text x="57" y="40" ${ _badgeSVGFont } font-size="15" font-weight="700" fill="#F9F4E3">${ esc(line2) }</text>`,
      `</svg>`,
    ].join("\n");
  }
</script>

<script define:vars={{ copyText, copiedText }}>
  const copyBtn  = document.getElementById("copy-btn");
  const embedCode = document.getElementById("embed-code");

  copyBtn.addEventListener("click", async () => {
    const text = embedCode.textContent;
    if (!text) return;
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const range = document.createRange();
      range.selectNodeContents(embedCode);
      const sel = window.getSelection();
      sel.removeAllRanges();
      sel.addRange(range);
    }
    copyBtn.textContent = copiedText;
    setTimeout(() => { copyBtn.textContent = copyText; }, 2000);
  });
</script>
