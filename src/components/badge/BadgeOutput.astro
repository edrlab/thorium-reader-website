---
import Tabs from "../widgets/Tabs.astro";
import { t, splitLinks } from "../../i18n/utils.js";
import { getRelativeLocaleUrl } from "astro:i18n";

interface Props {
  lang: string;
}

const { lang } = Astro.props;

const copyText   = t(lang, "badge.shared.output.copy");
const copiedText = t(lang, "badge.shared.output.copied");

const devGuidesSegments = splitLinks(t(lang, "badge.shared.webcomponent.hint"), {
  devguides: { href: getRelativeLocaleUrl(lang, "guides/deep-linking"), text: t(lang, "badge.shared.webcomponent.devguides") },
});
---

<div class="badge-output" aria-live="polite">
  <Tabs
    tabs={[
      { id: "preview", label: t(lang, "badge.shared.preview.title") },
      { id: "code",    label: t(lang, "badge.shared.output.title") },
    ]}
    label={ t(lang, "badge.shared.output.title") }
  >
    <div id="panel-preview" role="tabpanel" aria-labelledby="preview" tabindex="0">
      <p class="field-hint">{ t(lang, "badge.shared.preview.hint") }</p>
      <div class="preview-display">
        <div id="preview-badge" aria-hidden="true"></div>
      </div>
    </div>

    <div id="panel-code" role="tabpanel" aria-labelledby="code" tabindex="0" hidden>
      <p class="field-hint" id="embed-code-hint-link">{ t(lang, "badge.shared.output.hint") }</p>
      <p class="field-hint" id="embed-code-hint-webcomponent" hidden>
        { devGuidesSegments.map(seg => typeof seg === "string" ? seg : <a href={ seg.href }>{ seg.text }</a>) }
      </p>
      <div class="embed-code-wrap">
        <pre><code id="embed-code"></code></pre>
        <button type="button" class="btn badge-copy-btn">
          { copyText }
        </button>
      </div>
    </div>
  </Tabs>
</div>

<script define:vars={{ copyText, copiedText }}>
  document.querySelectorAll(".embed-code-wrap").forEach((wrap) => {
    const code    = wrap.querySelector("code");
    const copyBtn = wrap.querySelector(".badge-copy-btn");

    copyBtn.addEventListener("click", async () => {
      const text = code.textContent;
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        const range = document.createRange();
        range.selectNodeContents(code);
        const sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
      }
      copyBtn.textContent = copiedText;
      setTimeout(() => { copyBtn.textContent = copyText; }, 2000);
    });
  });
</script>
