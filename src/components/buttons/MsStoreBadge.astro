---
import type { Locale } from "../../i18n/locales.js";
import { bcp47Locale } from "../../i18n/locales.js";
import { msProductId } from "../../config.js";

const lang = Astro.currentLocale as Locale;
const language = bcp47Locale[lang] ?? bcp47Locale.en;
---

<script type="module" src="https://get.microsoft.com/badge/ms-store-badge.bundled.js"></script>
<ms-store-badge
  productid={ msProductId }
  productname="Thorium Reader"
  window-mode="direct"
  theme="dark"
  size="small"
  language={ language }
  animation="off">
</ms-store-badge>
