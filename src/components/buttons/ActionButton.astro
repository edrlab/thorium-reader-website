---
import Button from "./Button.astro";
import { t } from "../../i18n/utils.js";
import downloadIcon from "./assets/download.svg?raw";

interface Props {
  href?: string;
  icon?: boolean;
  label?: string;
  variant?: "default" | "accent";
}

const { href = "#", icon = false, label, variant = "default" } = Astro.props;
const lang = Astro.currentLocale;
---

<Button
  label={ label ?? t(lang, "button.download") }
  href={ href }
  icon={ icon ? downloadIcon : undefined }
  class={ variant === "accent" ? "action-button-accent" : "action-button" }
/>
