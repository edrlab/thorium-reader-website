---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import { t } from "../i18n/utils.js";
import { discordHref as defaultDiscordHref } from "../links.js";
import DiscordButton from "./buttons/DiscordButton.astro";
import AppStoreBadge from "./buttons/AppStoreBadge.astro";
import MsStoreBadge from "./buttons/MsStoreBadge.astro";
import EdrlabLogo from "./logos/EdrlabLogo.astro";
import rawShape4 from "../assets/shapes/thorium-shape-4.svg?raw";

interface Props {
  image?: { src: ImageMetadata; alt?: string };
  clip?: boolean;
  discordHref?: string;
}

const { image, clip = false, discordHref } = Astro.props;
const lang = Astro.currentLocale ?? "en";
const year = new Date().getFullYear();
const conformancePath = getRelativeLocaleUrl(lang, "legals");
const accessibilityPath = getRelativeLocaleUrl(lang, "accessibility");
const guidesPath = getRelativeLocaleUrl(lang, "guides");
---

<div class:list={["footer-top", { "has-image": image, clipped: image && clip }]}>
  { image && (
    <Image
      class="footer-image"
      src={ image.src }
      alt={ image.alt ?? "" }
    />
  ) }
  <div class="footer-wave" aria-hidden="true">
    <Fragment set:html={ rawShape4 } />
  </div>
</div>

<footer class="site-footer">
  <div class="container footer-inner">

    <a class="footer-edrlab" href="https://www.edrlab.org/" aria-label="EDRLab">
      <EdrlabLogo />
    </a>

    <div class="footer-actions">
      <AppStoreBadge />
      <MsStoreBadge />
      <DiscordButton href={ discordHref ?? defaultDiscordHref } />
    </div>

  </div>

  <div class="container footer-copy">
    <span>EDRLab &copy; { year }</span>
    <span aria-hidden="true" style="padding-inline: 0.5rem">|</span>
    <a href={ conformancePath }>{ t(lang, "footer.legal") }</a>
    <span aria-hidden="true" style="padding-inline: 0.5rem">|</span>
    <a href={ accessibilityPath }>{ t(lang, "footer.accessibility") }</a>
    <span aria-hidden="true" style="padding-inline: 0.5rem">|</span>
    <a href={ guidesPath }>{ t(lang, "footer.guides") }</a>
  </div>
</footer>
