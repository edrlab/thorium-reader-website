---
import { locales, defaultLocale } from "../i18n/locales.js";
const { path } = Astro.props;
const base = import.meta.env.BASE_URL;
const fallback = `${ base }${ defaultLocale }/${ path }`;
---
<noscript><meta http-equiv="refresh" content={ `0;url=${ fallback }` } /></noscript>
<script define:vars={{ locales, defaultLocale, base, path }}>
  const preferred = navigator.languages
    .map(tag => tag.split("-")[0].toLowerCase())
    .find(lang => locales.includes(lang));
  location.replace(`${ base }${ preferred ?? defaultLocale }/${ path }${ location.search }${ location.hash }`);
</script>
