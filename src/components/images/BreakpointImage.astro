---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Source {
  src: ImageMetadata;
  alt: string;
  media?: string;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
const uid = Math.random().toString(36).slice(2, 7);

const mediaSources  = sources.filter(s => s.media);
const defaultSource = sources.find(s => !s.media);

let css = "";

if (defaultSource) {
  const idx = sources.indexOf(defaultSource);
  css += `.bi-${ uid }-${ idx }{display:block}`;
  mediaSources.forEach(s => {
    css += `@media ${ s.media }{.bi-${ uid }-${ idx }{display:none}}`;
  });
}

mediaSources.forEach(s => {
  const idx = sources.indexOf(s);
  css += `.bi-${ uid }-${ idx }{display:none}@media ${ s.media }{.bi-${ uid }-${ idx }{display:block}}`;
});
---

{ sources.map((source, i) => (
  <Image class={ `bi-${ uid }-${ i }` } src={ source.src } alt={ source.alt } />
))}

<style is:inline set:html={ css }></style>
