---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  style?: string;
  [key: string]: unknown;
}

const { src, alt, style, ...rest } = Astro.props;

// Reserves the image's box before it loads, regardless of the CSS used to
// constrain its rendered size, since `src` (and therefore its intrinsic
// ratio) can differ per locale.
const aspectRatio = `aspect-ratio: ${ src.width } / ${ src.height };`;
---

<Image src={ src } alt={ alt } style={ style ? `${ aspectRatio } ${ style }` : aspectRatio } {...rest} />
