---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import shape1Large from "../../assets/shapes/thorium-shape-1-large.svg?raw";

interface Props {
  blob?: string | ImageMetadata;
}

const { blob = shape1Large } = Astro.props;
const blobIsImage = typeof blob !== "string";
---
{ blobIsImage
  ? <Image src={ blob as ImageMetadata } alt="" />
  : <Fragment set:html={ blob } />
}
