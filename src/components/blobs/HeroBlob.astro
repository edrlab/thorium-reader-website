---
import type { ImageMetadata } from "astro";
import SizedImage from "../images/SizedImage.astro";
import shape1Large from "../../assets/shapes/thorium-shape-1-large.svg?raw";

interface Props {
  blob?: string | ImageMetadata;
  illustration?: { src: ImageMetadata };
}

const { blob = shape1Large, illustration } = Astro.props;
const blobIsImage = typeof blob !== "string";
---
<div class="hero-blob" aria-hidden="true">
  { blobIsImage
    ? <SizedImage src={ blob as ImageMetadata } alt="" loading="eager" fetchpriority="high" />
    : <Fragment set:html={ blob } />
  }
</div>
{ illustration && (
  <SizedImage
    class="hero-illustration"
    src={ illustration.src }
    alt=""
    loading="eager"
    fetchpriority="high"
    aria-hidden="true"
    widths={ [280, 420, 560, 840] }
    sizes="280px"
  />
) }
