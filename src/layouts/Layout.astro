---
import "../styles/global.css";
import Header from "../components/Header.astro";
import HeroBlob from "../components/blobs/HeroBlob.astro";
import { t } from "../i18n/utils.js";

const { title } = Astro.props;
const lang = Astro.currentLocale;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{ title ?? t(lang, "site.title") }</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Caprasimo&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Libre+Franklin:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ t(lang, "a11y.skipToMain") }</a>

    <div class="hero-blob" aria-hidden="true">
      <HeroBlob />
    </div>

    <Header />

    <main id="main-content">
      <slot />
    </main>
    <script>
      const hero = document.querySelector(".hero");
      if (hero) {
        let raf = 0;
        const ro = new ResizeObserver(() => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            document.documentElement.style.setProperty("--blob-wave-y", hero.getBoundingClientRect().height + "px");
          });
        });
        ro.observe(hero);
      }
    </script>
  </body>
</html>
