---
import { Font } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import "../styles/global.css";
import Header from "../components/Header.astro";
import HeroBlob from "../components/blobs/HeroBlob.astro";
import { t } from "../i18n/utils.js";
import { defaultLocale, locales, bcp47Locale } from "../i18n/locales.js";

const { title, description, blob = false, illustration, noindex = false } = Astro.props;
const lang = Astro.currentLocale ?? defaultLocale;

// Same locale-stripping approach as LanguagePicker.astro, so canonical/hreflang
// stay consistent with the language switcher's own URL generation.
const withoutBase = Astro.url.pathname.slice(import.meta.env.BASE_URL.length);
const currentPath = "/" + withoutBase.split("/").filter(Boolean).slice(1).join("/");
const localizedUrl = (locale: string) => new URL(getRelativeLocaleUrl(locale, currentPath), Astro.site);
---

<!doctype html>
<html lang={ lang }>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={ description ?? t(lang, "site.description") } />
    <title>{ title ?? t(lang, "site.title") }</title>
    { noindex && <meta name="robots" content="noindex" /> }
    <link rel="canonical" href={ localizedUrl(lang).href } />
    { locales.map((locale) => (
      <link rel="alternate" hreflang={ bcp47Locale[locale] } href={ localizedUrl(locale).href } />
    )) }
    <link rel="alternate" hreflang="x-default" href={ localizedUrl(defaultLocale).href } />
    <link rel="icon" type="image/svg+xml" href={`${ import.meta.env.BASE_URL }favicon.svg`} />
    <link rel="icon" type="image/x-icon" href={`${ import.meta.env.BASE_URL }favicon.ico`} />
    <link rel="apple-touch-icon" href={`${ import.meta.env.BASE_URL }apple-touch-icon.png`} />
    <link rel="sitemap" href={`${ import.meta.env.BASE_URL }sitemap-index.xml`} />
    <Font cssVariable="--font-heading" />
    <Font cssVariable="--font-sans" />
    { import.meta.env.PROD && import.meta.env.PUBLIC_GA_MEASUREMENT_ID && (
      <>
        <script is:inline async src={ `https://www.googletagmanager.com/gtag/js?id=${ import.meta.env.PUBLIC_GA_MEASUREMENT_ID }` }></script>
        <script define:vars={{ gaMeasurementId: import.meta.env.PUBLIC_GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          window.gtag = function() { dataLayer.push(arguments); };
          gtag("js", new Date());
          gtag("config", gaMeasurementId);
        </script>
      </>
    ) }
  </head>
  <body>
    <a class="skip-link" href="#main-content">{ t(lang, "a11y.skipToMain") }</a>

    { blob && <HeroBlob illustration={ illustration } /> }

    <Header />

    <main id="main-content">
      <slot />
    </main>

    <slot name="footer" />

    <script>
      const hero = document.querySelector(".hero");
      if (hero) {
        let raf = 0;
        const ro = new ResizeObserver(() => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            document.documentElement.style.setProperty("--blob-wave-y", hero.getBoundingClientRect().height + "px");
          });
        });
        ro.observe(hero);
      }
    </script>
  </body>
</html>
