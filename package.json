{
  "name": "thorium-site",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @edrlab/thorium-badges build && concurrently -k \"pnpm --filter @edrlab/thorium-badges dev\" \"astro dev\"",
    "build": "pnpm --filter @edrlab/thorium-badges build && astro build && node scripts/copy-embed.mjs",
    "preview": "astro preview"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=22.6.0",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.2",
    "@edrlab/thorium-badges": "workspace:*",
    "astro": "^6.3.1",
    "i18next": "^26.1.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "concurrently": "^10.0.3"
  }
}
